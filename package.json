{
  "name": "vitasight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/setup-face.mjs",
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "prebuild": "node scripts/setup-face.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "vision:setup": "node scripts/setup-vision.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:pulse": "node scripts/pulse-browser-check.mjs",
    "format": "prettier --write src server shared tests scripts docs *.ts *.json *.html README.md .github",
    "format:check": "prettier --check src server shared tests scripts docs *.ts *.json *.html README.md .github"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
